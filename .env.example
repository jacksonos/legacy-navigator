# A provider is enabled when its key AND its model are set.
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5-5 when empty
ANTHROPIC_MODEL=
OPENAI_API_KEY=
# Required with OPENAI_API_KEY (no default: model names expire)
OPENAI_MODEL=
GEMINI_API_KEY=
# Required with GEMINI_API_KEY (no default: model names expire)
GEMINI_MODEL=
OPENROUTER_API_KEY=
# Required with OPENROUTER_API_KEY: provider-prefixed id, e.g. openai/gpt-4o
OPENROUTER_MODEL=
# Max characters of code sent to the LLM as evidence (default 24000)
ASK_MAX_CHARS=
DB_PATH=
ADDR=
