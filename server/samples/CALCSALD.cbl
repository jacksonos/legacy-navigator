       IDENTIFICATION DIVISION.
       PROGRAM-ID. CALCSALD.
      * ACTUALIZA EL SALDO DE LAS CUENTAS CON LOS MOVIMIENTOS DEL DIA
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MOVIMIENTOS ASSIGN TO 'MOVIMIENTOS.DAT'
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS WS-FS-MOV.
           SELECT CUENTAS ASSIGN TO 'CUENTAS.DAT'
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS WS-CLAVE-CTA
               FILE STATUS IS WS-FS-CTA.
           SELECT REPORTE ASSIGN TO 'REPORTE.TXT'
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-FS-REP.
       DATA DIVISION.
       FILE SECTION.
       FD  MOVIMIENTOS.
           COPY MOVREG.
       FD  CUENTAS.
           COPY CTAREG.
       FD  REPORTE.
       01  REP-LINEA               PIC X(80).
       WORKING-STORAGE SECTION.
           COPY AUDITREG.
       01  WS-FS-MOV               PIC XX.
       01  WS-FS-CTA               PIC XX.
       01  WS-FS-REP               PIC XX.
       01  WS-CLAVE-CTA            PIC 9(10).
       01  WS-FIN-MOV              PIC X VALUE 'N'.
           88  FIN-MOVIMIENTOS     VALUE 'S'.
       01  WS-VALIDO               PIC X.
       01  WS-RUTINA               PIC X(8) VALUE 'AUDITAR'.
       01  WS-TOTAL-DEPOSITOS      PIC S9(11)V99 VALUE 0.
       01  WS-TOTAL-RETIROS        PIC S9(11)V99 VALUE 0.
       01  WS-CONTADOR             PIC 9(6) VALUE 0.
       01  WS-LINEA-REP.
           05  FILLER              PIC X(8) VALUE 'CUENTA: '.
           05  REP-CUENTA          PIC 9(10).
           05  FILLER              PIC X(9) VALUE ' SALDO:  '.
           05  REP-SALDO           PIC -(11)9.99.
       PROCEDURE DIVISION.
       0000-PRINCIPAL.
           PERFORM 1000-INICIO
           PERFORM 2000-LEER-MOV THRU 2000-EXIT
           PERFORM 3000-PROCESAR UNTIL FIN-MOVIMIENTOS
           PERFORM 9000-FIN
           STOP RUN.
      * ABRE LOS ARCHIVOS DEL PROCESO
       1000-INICIO.
           OPEN INPUT MOVIMIENTOS
           OPEN I-O CUENTAS
           OPEN OUTPUT REPORTE.
      * LEE EL SIGUIENTE MOVIMIENTO
       2000-LEER-MOV.
           READ MOVIMIENTOS
               AT END
                   SET FIN-MOVIMIENTOS TO TRUE
                   GO TO 2000-EXIT
           END-READ
           ADD 1 TO WS-CONTADOR.
       2000-EXIT.
           EXIT.
      * PROCESA UN MOVIMIENTO Y LEE EL SIGUIENTE
       3000-PROCESAR.
           CALL 'VALIDAR' USING MOV-IMPORTE WS-VALIDO
           IF WS-VALIDO = 'S'
               PERFORM 4000-CALCULAR-SALDO
               PERFORM 5000-ESCRIBIR-REPORTE
           ELSE
               CALL WS-RUTINA USING MOV-REGISTRO
           END-IF
           PERFORM 2000-LEER-MOV THRU 2000-EXIT.
      * CALCULA EL SALDO DE LA CUENTA
       4000-CALCULAR-SALDO.
           MOVE MOV-CUENTA TO WS-CLAVE-CTA
           READ CUENTAS
               INVALID KEY
                   DISPLAY 'CUENTA NO ENCONTRADA: ' MOV-CUENTA
           END-READ
           EVALUATE TRUE
               WHEN MOV-DEPOSITO
                   ADD MOV-IMPORTE TO WS-TOTAL-DEPOSITOS
                   COMPUTE CTA-SALDO = CTA-SALDO + MOV-IMPORTE
               WHEN MOV-RETIRO
                   SUBTRACT MOV-IMPORTE FROM CTA-SALDO
                   ADD MOV-IMPORTE TO WS-TOTAL-RETIROS
               WHEN OTHER
                   DISPLAY 'TIPO DE MOVIMIENTO INVALIDO'
           END-EVALUATE
           REWRITE CTA-REGISTRO
               INVALID KEY
                   DISPLAY 'ERROR AL ACTUALIZAR CUENTA'
           END-REWRITE.
      * ESCRIBE LA LINEA DEL REPORTE CON EL NUEVO SALDO
       5000-ESCRIBIR-REPORTE.
           MOVE CTA-NUMERO TO REP-CUENTA
           MOVE CTA-SALDO TO REP-SALDO
           WRITE REP-LINEA FROM WS-LINEA-REP.
      * CIERRA LOS ARCHIVOS
       9000-FIN.
           CLOSE MOVIMIENTOS
           CLOSE CUENTAS
           CLOSE REPORTE
           DISPLAY 'MOVIMIENTOS PROCESADOS: ' WS-CONTADOR.
