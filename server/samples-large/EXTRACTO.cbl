       IDENTIFICATION DIVISION.
       PROGRAM-ID. EXTRACTO.
      *================================================================
      * EXTRACTO - EMISION DEL EXTRACTO MENSUAL DE CADA CUENTA
      * PARA CADA CUENTA ACTIVA IMPRIME UNA CABECERA CON EL NOMBRE
      * DEL TITULAR, EL DETALLE DE LOS MOVIMIENTOS DEL MES CON EL
      * SALDO ACUMULADO LINEA A LINEA Y UN PIE CON EL SALDO FINAL.
      * EL HISTORICO DE MOVIMIENTOS VIENE ORDENADO POR CUENTA Y SE
      * CRUZA CON EL MAESTRO (CORTE DE CONTROL POR CUENTA). EL SALDO
      * DE APERTURA SE OBTIENE RESTANDO AL SALDO ACTUAL EL EFECTO NETO
      * DE LOS MOVIMIENTOS DEL MES. CADA 55 LINEAS SE HACE SALTO DE
      * PAGINA Y SE REPITE LA CABECERA CON EL NUMERO DE PAGINA.
      *================================================================
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CUENTAS ASSIGN TO 'CUENTAS.DAT'
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS WS-FS-CTA.
           SELECT MOVHIST ASSIGN TO 'MOVHIST.DAT'
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS WS-FS-HIS.
           SELECT CLIENTES ASSIGN TO 'CLIENTES.DAT'
               ORGANIZATION IS INDEXED
               ACCESS MODE IS RANDOM
               RECORD KEY IS CLI-NUMERO
               FILE STATUS IS WS-FS-CLI.
           SELECT EXTRACTOS ASSIGN TO 'EXTRACTOS.TXT'
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-FS-EXT.
       DATA DIVISION.
       FILE SECTION.
       FD  CUENTAS.
           COPY CTAREG.
       FD  MOVHIST.
           COPY MOVREG.
       FD  CLIENTES.
           COPY CLIREG.
       FD  EXTRACTOS.
       01  EXT-LINEA               PIC X(132).
       WORKING-STORAGE SECTION.
           COPY EXTREG.
           COPY AUDREG.
           COPY ERRREG.
           COPY FECHAREG.
       01  WS-FS-CTA               PIC XX.
           88  CTA-FS-OK           VALUE '00'.
       01  WS-FS-HIS               PIC XX.
       01  WS-FS-CLI               PIC XX.
       01  WS-FS-EXT               PIC XX.
       01  WS-FIN-CTA              PIC X VALUE 'N'.
           88  FIN-CUENTAS         VALUE 'S'.
       01  WS-FIN-HIS              PIC X VALUE 'N'.
           88  FIN-HISTORICO       VALUE 'S'.
       01  WS-PAGINA               PIC 9(4) VALUE 0.
       01  WS-LINEAS-PAGINA        PIC 99 VALUE 99.
       01  WS-MAX-LINEAS           PIC 99 VALUE 55.
       01  WS-NUM-MOVS             PIC 999 VALUE 0.
       01  WS-TABLA-MOVS.
           05  WS-MOV-FILA OCCURS 200 TIMES.
               10  MT-FECHA        PIC 9(8).
               10  MT-TIPO         PIC X.
               10  MT-IMPORTE      PIC S9(9)V99.
       01  WS-IDX                  PIC 999.
       01  WS-NETO-MES             PIC S9(11)V99.
       01  WS-SALDO-APERTURA       PIC S9(11)V99.
       01  WS-SALDO-CORRIDO        PIC S9(11)V99.
       01  WS-EFECTO               PIC S9(9)V99.
       01  WS-NOMBRE-TITULAR       PIC X(30).
       01  WS-RESUMEN-TIPOS.
           05  WS-RES-FILA OCCURS 4 TIMES.
               10  WS-RES-TIPO     PIC X.
               10  WS-RES-CANTIDAD PIC 9(7).
               10  WS-RES-SALDO    PIC S9(13)V99.
       01  WS-IDX-RES              PIC 9.
       01  WS-TOTALES.
           05  WS-EXTRACTOS-EMITIDOS PIC 9(7) VALUE 0.
           05  WS-PAGINAS-TOTAL    PIC 9(7) VALUE 0.
           05  WS-MOVS-IMPRESOS    PIC 9(9) VALUE 0.
       PROCEDURE DIVISION.
       0000-PRINCIPAL.
           PERFORM 1000-INICIO
           PERFORM 2000-LEER-CUENTA
           PERFORM 2100-LEER-HISTORICO
           PERFORM 3000-PROCESAR-CUENTA UNTIL FIN-CUENTAS
           PERFORM 9000-FIN
           GOBACK.
       1000-INICIO.
           OPEN INPUT CUENTAS
           OPEN INPUT MOVHIST
           OPEN INPUT CLIENTES
           OPEN OUTPUT EXTRACTOS
           IF NOT CTA-FS-OK
               MOVE 3301 TO ERR-CODIGO
               MOVE 'NO SE PUDO ABRIR CUENTAS' TO ERR-TEXTO
               PERFORM 8900-ERROR-FATAL
           END-IF
           PERFORM 1100-AUDITAR-INICIO.
       1100-AUDITAR-INICIO.
           MOVE 'EXTRACTO' TO AUD-PROGRAMA
           MOVE 'INICIO' TO AUD-ACCION
           MOVE 0 TO AUD-FECHA AUD-HORA AUD-CUENTA AUD-IMPORTE
           MOVE 'COMIENZA LA EMISION DE EXTRACTOS' TO AUD-DETALLE
           CALL 'AUDITLOG' USING AUD-REGISTRO.
       2000-LEER-CUENTA.
           READ CUENTAS
               AT END
                   SET FIN-CUENTAS TO TRUE
           END-READ.
       2100-LEER-HISTORICO.
           READ MOVHIST
               AT END
                   SET FIN-HISTORICO TO TRUE
           END-READ.
      * UNA CUENTA ACTIVA O BLOQUEADA GENERA EXTRACTO; LAS CERRADAS NO
       3000-PROCESAR-CUENTA.
           IF CTA-ACTIVA OR CTA-BLOQUEADA
               PERFORM 3100-CARGAR-MOVIMIENTOS
               PERFORM 3200-CALCULAR-APERTURA
               PERFORM 3300-BUSCAR-TITULAR
               PERFORM 4000-IMPRIMIR-EXTRACTO
           ELSE
               PERFORM 3150-SALTAR-MOVIMIENTOS
           END-IF
           PERFORM 2000-LEER-CUENTA.
      * CARGA EN LA TABLA LOS MOVIMIENTOS DE LA CUENTA ACTUAL; LOS DE
      * CUENTAS MENORES SE DESCARTAN Y LOS SOBRANTES (MAS DE 200)
      * SE IGNORAN
       3100-CARGAR-MOVIMIENTOS.
           MOVE 0 TO WS-NUM-MOVS
           MOVE 0 TO WS-NETO-MES
           PERFORM UNTIL FIN-HISTORICO OR MOV-CUENTA >= CTA-NUMERO
               PERFORM 2100-LEER-HISTORICO
           END-PERFORM
           PERFORM UNTIL FIN-HISTORICO OR MOV-CUENTA NOT = CTA-NUMERO
               IF WS-NUM-MOVS < 200
                   PERFORM 3110-GUARDAR-MOVIMIENTO
               END-IF
               PERFORM 2100-LEER-HISTORICO
           END-PERFORM.
       3110-GUARDAR-MOVIMIENTO.
           ADD 1 TO WS-NUM-MOVS
           MOVE MOV-FECHA TO MT-FECHA(WS-NUM-MOVS)
           MOVE MOV-TIPO TO MT-TIPO(WS-NUM-MOVS)
           MOVE MOV-IMPORTE TO MT-IMPORTE(WS-NUM-MOVS)
           PERFORM 3120-EFECTO-SOBRE-SALDO
           ADD WS-EFECTO TO WS-NETO-MES.
      * DEPOSITOS, INTERESES Y AJUSTES SUMAN; RETIROS, TRANSFERENCIAS
      * Y COMISIONES RESTAN
       3120-EFECTO-SOBRE-SALDO.
           EVALUATE TRUE
               WHEN MOV-DEPOSITO
                   MOVE MOV-IMPORTE TO WS-EFECTO
               WHEN MOV-INTERES
                   MOVE MOV-IMPORTE TO WS-EFECTO
               WHEN MOV-AJUSTE
                   MOVE MOV-IMPORTE TO WS-EFECTO
               WHEN OTHER
                   COMPUTE WS-EFECTO = 0 - MOV-IMPORTE
           END-EVALUATE.
       3150-SALTAR-MOVIMIENTOS.
           PERFORM UNTIL FIN-HISTORICO OR MOV-CUENTA > CTA-NUMERO
               PERFORM 2100-LEER-HISTORICO
           END-PERFORM.
       3200-CALCULAR-APERTURA.
           COMPUTE WS-SALDO-APERTURA = CTA-SALDO - WS-NETO-MES
           MOVE WS-SALDO-APERTURA TO WS-SALDO-CORRIDO.
       3300-BUSCAR-TITULAR.
           MOVE CTA-CLIENTE TO CLI-NUMERO
           READ CLIENTES
               INVALID KEY
                   MOVE CTA-TITULAR TO WS-NOMBRE-TITULAR
               NOT INVALID KEY
                   MOVE CLI-NOMBRE TO WS-NOMBRE-TITULAR
           END-READ.
      * IMPRIME EL EXTRACTO COMPLETO DE UNA CUENTA
       4000-IMPRIMIR-EXTRACTO.
           PERFORM 4100-SALTO-DE-PAGINA
           PERFORM 4200-LINEA-TITULAR
           PERFORM 4300-IMPRIMIR-DETALLE
               VARYING WS-IDX FROM 1 BY 1 UNTIL WS-IDX > WS-NUM-MOVS
           PERFORM 4400-IMPRIMIR-PIE
           ADD 1 TO WS-EXTRACTOS-EMITIDOS
           PERFORM 4500-ACUMULAR-TIPO.
      * SALTO DE PAGINA CON CABECERA Y NUMERO DE PAGINA
       4100-SALTO-DE-PAGINA.
           ADD 1 TO WS-PAGINA
           ADD 1 TO WS-PAGINAS-TOTAL
           MOVE WS-PAGINA TO EXT-CAB-PAGINA
           WRITE EXT-LINEA FROM EXT-CABECERA AFTER ADVANCING PAGE
           MOVE 1 TO WS-LINEAS-PAGINA.
       4200-LINEA-TITULAR.
           MOVE CTA-NUMERO TO EXT-TIT-CUENTA
           MOVE WS-NOMBRE-TITULAR TO EXT-TIT-NOMBRE
           WRITE EXT-LINEA FROM EXT-TITULAR-LINEA AFTER ADVANCING 2
           ADD 3 TO WS-LINEAS-PAGINA.
      * UNA LINEA POR MOVIMIENTO; SI SE LLENA LA PAGINA SE CAMBIA
       4300-IMPRIMIR-DETALLE.
           IF WS-LINEAS-PAGINA >= WS-MAX-LINEAS
               PERFORM 4100-SALTO-DE-PAGINA
               PERFORM 4200-LINEA-TITULAR
           END-IF
           PERFORM 4310-CALCULAR-LINEA
           WRITE EXT-LINEA FROM EXT-DETALLE
           ADD 1 TO WS-LINEAS-PAGINA
           ADD 1 TO WS-MOVS-IMPRESOS.
       4310-CALCULAR-LINEA.
           MOVE MT-FECHA(WS-IDX) TO EXT-DET-FECHA
           MOVE MT-IMPORTE(WS-IDX) TO EXT-DET-IMPORTE
           EVALUATE MT-TIPO(WS-IDX)
               WHEN 'D'
                   MOVE 'DEPOSITO' TO EXT-DET-CONCEPTO
                   ADD MT-IMPORTE(WS-IDX) TO WS-SALDO-CORRIDO
               WHEN 'R'
                   MOVE 'RETIRO' TO EXT-DET-CONCEPTO
                   SUBTRACT MT-IMPORTE(WS-IDX) FROM WS-SALDO-CORRIDO
               WHEN 'T'
                   MOVE 'TRANSFERENCIA' TO EXT-DET-CONCEPTO
                   SUBTRACT MT-IMPORTE(WS-IDX) FROM WS-SALDO-CORRIDO
               WHEN 'I'
                   MOVE 'INTERESES' TO EXT-DET-CONCEPTO
                   ADD MT-IMPORTE(WS-IDX) TO WS-SALDO-CORRIDO
               WHEN 'C'
                   MOVE 'COMISION' TO EXT-DET-CONCEPTO
                   SUBTRACT MT-IMPORTE(WS-IDX) FROM WS-SALDO-CORRIDO
               WHEN OTHER
                   MOVE 'AJUSTE' TO EXT-DET-CONCEPTO
                   ADD MT-IMPORTE(WS-IDX) TO WS-SALDO-CORRIDO
           END-EVALUATE
           MOVE WS-SALDO-CORRIDO TO EXT-DET-SALDO.
       4400-IMPRIMIR-PIE.
           MOVE CTA-SALDO TO EXT-TOT-SALDO
           WRITE EXT-LINEA FROM EXT-TOTAL-LINEA AFTER ADVANCING 2
           ADD 3 TO WS-LINEAS-PAGINA.
      * ACUMULA CANTIDAD DE EXTRACTOS Y SALDO POR TIPO DE CUENTA PARA
      * EL RESUMEN QUE SE MUESTRA AL FINAL DE LA EMISION
       4500-ACUMULAR-TIPO.
           IF WS-RES-TIPO(1) = SPACES
               PERFORM 4510-INICIAR-RESUMEN
           END-IF
           PERFORM VARYING WS-IDX-RES FROM 1 BY 1 UNTIL WS-IDX-RES > 4
               IF WS-RES-TIPO(WS-IDX-RES) = CTA-TIPO
                   ADD 1 TO WS-RES-CANTIDAD(WS-IDX-RES)
                   ADD CTA-SALDO TO WS-RES-SALDO(WS-IDX-RES)
               END-IF
           END-PERFORM.
       4510-INICIAR-RESUMEN.
           MOVE 'C' TO WS-RES-TIPO(1)
           MOVE 'A' TO WS-RES-TIPO(2)
           MOVE 'P' TO WS-RES-TIPO(3)
           MOVE 'L' TO WS-RES-TIPO(4)
           PERFORM VARYING WS-IDX-RES FROM 1 BY 1 UNTIL WS-IDX-RES > 4
               MOVE 0 TO WS-RES-CANTIDAD(WS-IDX-RES)
               MOVE 0 TO WS-RES-SALDO(WS-IDX-RES)
           END-PERFORM.
       4600-MOSTRAR-RESUMEN.
           PERFORM VARYING WS-IDX-RES FROM 1 BY 1 UNTIL WS-IDX-RES > 4
               DISPLAY 'TIPO ' WS-RES-TIPO(WS-IDX-RES)
                   ' EXTRACTOS ' WS-RES-CANTIDAD(WS-IDX-RES)
                   ' SALDO ' WS-RES-SALDO(WS-IDX-RES)
           END-PERFORM.
       8900-ERROR-FATAL.
           MOVE 'EXTRACTO' TO ERR-PROGRAMA
           MOVE 3 TO ERR-SEVERIDAD
           CALL 'ERRORES' USING ERR-AREA
           STOP RUN.
       9000-FIN.
           DISPLAY 'EXTRACTOS EMITIDOS: ' WS-EXTRACTOS-EMITIDOS
           DISPLAY 'PAGINAS IMPRESAS:   ' WS-PAGINAS-TOTAL
           PERFORM 4600-MOSTRAR-RESUMEN
           MOVE 'EXTRACTO' TO AUD-PROGRAMA
           MOVE 'FIN' TO AUD-ACCION
           MOVE WS-EXTRACTOS-EMITIDOS TO AUD-CUENTA
           MOVE 0 TO AUD-FECHA AUD-HORA AUD-IMPORTE
           MOVE 'EXTRACTOS MENSUALES EMITIDOS' TO AUD-DETALLE
           CALL 'AUDITLOG' USING AUD-REGISTRO
           CLOSE CUENTAS
           CLOSE MOVHIST
           CLOSE CLIENTES
           CLOSE EXTRACTOS.
