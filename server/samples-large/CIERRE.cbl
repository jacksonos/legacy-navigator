       IDENTIFICATION DIVISION.
       PROGRAM-ID. CIERRE.
      *================================================================
      * CIERRE - CIERRE CONTABLE DEL DIA DEL BATCH BANCARIO
      * ULTIMO PASO DEL PROCESO NOCTURNO. RECORRE EL MAESTRO DE
      * CUENTAS Y OBTIENE LOS TOTALES DE CONTROL: NUMERO DE CUENTAS Y
      * SALDO TOTAL POR ESTADO. LOS COMPARA CON LOS TOTALES ESPERADOS
      * DEL ARCHIVO DE CONTROL; SI LA DIFERENCIA SUPERA LA TOLERANCIA
      * SE MARCA EL CIERRE COMO DESCUADRADO Y SE AVISA AL EQUIPO DE
      * OPERACIONES. SI CUADRA SE GRABA LA FECHA DEL PROXIMO DIA
      * HABIL COMO NUEVA FECHA DE PROCESO. TODO QUEDA EN AUDITORIA.
      *================================================================
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CUENTAS ASSIGN TO 'CUENTAS.DAT'
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS WS-FS-CTA.
           SELECT CONTROLES ASSIGN TO 'CONTROL.DAT'
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS WS-FS-CON.
       DATA DIVISION.
       FILE SECTION.
       FD  CUENTAS.
           COPY CTAREG.
       FD  CONTROLES.
       01  CON-REGISTRO.
           05  CON-FECHA-PROCESO   PIC 9(8).
           05  CON-TOTAL-CUENTAS   PIC 9(9).
           05  CON-SALDO-ESPERADO  PIC S9(13)V99.
           05  CON-PROXIMA-FECHA   PIC 9(8).
       WORKING-STORAGE SECTION.
           COPY AUDREG.
           COPY ERRREG.
           COPY FECHAREG.
           COPY NOTIFREG.
       01  WS-FS-CTA               PIC XX.
           88  CTA-FS-OK           VALUE '00'.
       01  WS-FS-CON               PIC XX.
           88  CON-FS-OK           VALUE '00'.
       01  WS-FIN-CTA              PIC X VALUE 'N'.
           88  FIN-CUENTAS         VALUE 'S'.
       01  WS-CUADRA               PIC X VALUE 'S'.
           88  CIERRE-CUADRA       VALUE 'S'.
           88  CIERRE-DESCUADRADO  VALUE 'N'.
       01  WS-MENSAJE              PIC X(60).
       01  WS-TOLERANCIA           PIC 9V99 VALUE 0.01.
       01  WS-TABLA-ESTADOS.
           05  WS-ESTADO-FILA OCCURS 4 TIMES.
               10  WS-EST-COD      PIC X.
               10  WS-EST-CUENTAS  PIC 9(9).
               10  WS-EST-SALDO    PIC S9(13)V99.
       01  WS-IDX                  PIC 9.
       01  WS-TOTAL-CUENTAS        PIC 9(9) VALUE 0.
       01  WS-SALDO-TOTAL          PIC S9(13)V99 VALUE 0.
       01  WS-DIFERENCIA           PIC S9(13)V99.
       01  WS-DIF-CUENTAS          PIC S9(9).
       01  WS-FECHA-PROCESO        PIC 9(8).
       PROCEDURE DIVISION.
       0000-PRINCIPAL.
           PERFORM 1000-INICIO
           PERFORM 2000-TOTALIZAR-CUENTAS UNTIL FIN-CUENTAS
           PERFORM 3000-LEER-CONTROL
           PERFORM 4000-COMPARAR-TOTALES THRU 4000-EXIT
           PERFORM 5000-RESOLVER-CIERRE
           PERFORM 6000-INFORME-POR-ESTADO
           PERFORM 9000-FIN
           GOBACK.
       1000-INICIO.
           ACCEPT WS-FECHA-PROCESO FROM DATE YYYYMMDD
           OPEN INPUT CUENTAS
           OPEN I-O CONTROLES
           IF NOT CTA-FS-OK OR NOT CON-FS-OK
               MOVE 3401 TO ERR-CODIGO
               MOVE 'NO SE PUDIERON ABRIR CUENTAS O CONTROL' TO
                   ERR-TEXTO
               PERFORM 8900-ERROR-FATAL
           END-IF
           PERFORM 1100-INICIAR-ESTADOS
           PERFORM 2100-LEER-CUENTA.
       1100-INICIAR-ESTADOS.
           MOVE 'A' TO WS-EST-COD(1)
           MOVE 'B' TO WS-EST-COD(2)
           MOVE 'C' TO WS-EST-COD(3)
           MOVE 'E' TO WS-EST-COD(4)
           PERFORM VARYING WS-IDX FROM 1 BY 1 UNTIL WS-IDX > 4
               MOVE 0 TO WS-EST-CUENTAS(WS-IDX)
               MOVE 0 TO WS-EST-SALDO(WS-IDX)
           END-PERFORM.
      * ACUMULA LA CUENTA EN LOS TOTALES GENERALES Y POR ESTADO
       2000-TOTALIZAR-CUENTAS.
           ADD 1 TO WS-TOTAL-CUENTAS
           ADD CTA-SALDO TO WS-SALDO-TOTAL
           PERFORM VARYING WS-IDX FROM 1 BY 1 UNTIL WS-IDX > 4
               IF WS-EST-COD(WS-IDX) = CTA-ESTADO
                   ADD 1 TO WS-EST-CUENTAS(WS-IDX)
                   ADD CTA-SALDO TO WS-EST-SALDO(WS-IDX)
               END-IF
           END-PERFORM
           PERFORM 2100-LEER-CUENTA.
       2100-LEER-CUENTA.
           READ CUENTAS
               AT END
                   SET FIN-CUENTAS TO TRUE
           END-READ.
       3000-LEER-CONTROL.
           READ CONTROLES
               AT END
                   MOVE 3402 TO ERR-CODIGO
                   MOVE 'ARCHIVO DE CONTROL VACIO' TO ERR-TEXTO
                   PERFORM 8900-ERROR-FATAL
           END-READ.
      * COMPARA CUENTAS Y SALDO TOTAL CONTRA LO ESPERADO; CUALQUIER
      * DIFERENCIA MARCA EL CIERRE COMO DESCUADRADO
       4000-COMPARAR-TOTALES.
           COMPUTE WS-DIF-CUENTAS = WS-TOTAL-CUENTAS
               - CON-TOTAL-CUENTAS
           IF WS-DIF-CUENTAS NOT = 0
               SET CIERRE-DESCUADRADO TO TRUE
               MOVE 'DIFERENCIA EN EL NUMERO DE CUENTAS' TO WS-MENSAJE
               GO TO 4000-EXIT
           END-IF
           COMPUTE WS-DIFERENCIA = WS-SALDO-TOTAL - CON-SALDO-ESPERADO
           IF WS-DIFERENCIA < 0
               COMPUTE WS-DIFERENCIA = 0 - WS-DIFERENCIA
           END-IF
           IF WS-DIFERENCIA > WS-TOLERANCIA
               SET CIERRE-DESCUADRADO TO TRUE
               MOVE 'DIFERENCIA EN EL SALDO TOTAL' TO WS-MENSAJE
           END-IF.
       4000-EXIT.
           EXIT.
      * SI CUADRA SE AVANZA LA FECHA DE PROCESO; SI NO, SE AVISA
       5000-RESOLVER-CIERRE.
           EVALUATE TRUE
               WHEN CIERRE-CUADRA
                   PERFORM 5100-AVANZAR-FECHA
                   PERFORM 5200-AUDITAR-CIERRE-OK
               WHEN CIERRE-DESCUADRADO
                   PERFORM 5300-AUDITAR-DESCUADRE
                   PERFORM 5400-NOTIFICAR-OPERACIONES
           END-EVALUATE.
      * LA NUEVA FECHA DE PROCESO ES EL PROXIMO DIA HABIL
       5100-AVANZAR-FECHA.
           MOVE 'S' TO FEC-FUNCION
           MOVE WS-FECHA-PROCESO TO FEC-FECHA-1
           MOVE 1 TO FEC-DIAS
           CALL 'FECHAS' USING FEC-AREA
           MOVE 'H' TO FEC-FUNCION
           MOVE FEC-RESULTADO TO FEC-FECHA-1
           CALL 'FECHAS' USING FEC-AREA
           MOVE WS-FECHA-PROCESO TO CON-FECHA-PROCESO
           MOVE FEC-RESULTADO TO CON-PROXIMA-FECHA
           MOVE WS-TOTAL-CUENTAS TO CON-TOTAL-CUENTAS
           MOVE WS-SALDO-TOTAL TO CON-SALDO-ESPERADO
           REWRITE CON-REGISTRO.
       5200-AUDITAR-CIERRE-OK.
           MOVE 'CIERRE' TO AUD-PROGRAMA
           MOVE 'CIERRE-OK' TO AUD-ACCION
           MOVE WS-TOTAL-CUENTAS TO AUD-CUENTA
           MOVE WS-SALDO-TOTAL TO AUD-IMPORTE
           MOVE WS-FECHA-PROCESO TO AUD-FECHA
           MOVE 0 TO AUD-HORA
           MOVE 'CIERRE DEL DIA CUADRADO' TO AUD-DETALLE
           CALL 'AUDITLOG' USING AUD-REGISTRO.
       5300-AUDITAR-DESCUADRE.
           MOVE 'CIERRE' TO AUD-PROGRAMA
           MOVE 'DESCUADRE' TO AUD-ACCION
           MOVE WS-DIF-CUENTAS TO AUD-CUENTA
           MOVE WS-DIFERENCIA TO AUD-IMPORTE
           MOVE WS-FECHA-PROCESO TO AUD-FECHA
           MOVE 0 TO AUD-HORA
           MOVE WS-MENSAJE TO AUD-DETALLE
           CALL 'AUDITLOG' USING AUD-REGISTRO.
      * AVISO AL EQUIPO DE OPERACIONES POR EL SERVICIO DE
      * NOTIFICACIONES (PROGRAMA EXTERNO, NO INCLUIDO EN ESTE JUEGO)
       5400-NOTIFICAR-OPERACIONES.
           CALL 'NOTIFICA' USING WS-MENSAJE.
      * INFORME DE CIERRE: CUENTAS Y SALDO POR ESTADO DE CUENTA
       6000-INFORME-POR-ESTADO.
           DISPLAY '--- INFORME DE CIERRE POR ESTADO ---'
           PERFORM 6100-LINEA-ESTADO
               VARYING WS-IDX FROM 1 BY 1 UNTIL WS-IDX > 4
           PERFORM 6200-VERIF-CUENTAS-EMBARGADAS.
       6100-LINEA-ESTADO.
           EVALUATE WS-EST-COD(WS-IDX)
               WHEN 'A'
                   DISPLAY 'ACTIVAS    ' WS-EST-CUENTAS(WS-IDX)
                       ' SALDO ' WS-EST-SALDO(WS-IDX)
               WHEN 'B'
                   DISPLAY 'BLOQUEADAS ' WS-EST-CUENTAS(WS-IDX)
                       ' SALDO ' WS-EST-SALDO(WS-IDX)
               WHEN 'C'
                   DISPLAY 'CERRADAS   ' WS-EST-CUENTAS(WS-IDX)
                       ' SALDO ' WS-EST-SALDO(WS-IDX)
               WHEN 'E'
                   DISPLAY 'EMBARGADAS ' WS-EST-CUENTAS(WS-IDX)
                       ' SALDO ' WS-EST-SALDO(WS-IDX)
           END-EVALUATE.
      * UNA CUENTA CERRADA NO DEBE TENER SALDO: SI LO TIENE SE AVISA
      * A AUDITORIA PARA QUE CONTABILIDAD LA REVISE
       6200-VERIF-CUENTAS-EMBARGADAS.
           IF WS-EST-SALDO(3) NOT = 0
               MOVE 'CIERRE' TO AUD-PROGRAMA
               MOVE 'REVISAR' TO AUD-ACCION
               MOVE WS-EST-CUENTAS(3) TO AUD-CUENTA
               MOVE WS-EST-SALDO(3) TO AUD-IMPORTE
               MOVE WS-FECHA-PROCESO TO AUD-FECHA
               MOVE 0 TO AUD-HORA
               MOVE 'CUENTAS CERRADAS CON SALDO' TO AUD-DETALLE
               CALL 'AUDITLOG' USING AUD-REGISTRO
           END-IF.
       8900-ERROR-FATAL.
           MOVE 'CIERRE' TO ERR-PROGRAMA
           MOVE 3 TO ERR-SEVERIDAD
           CALL 'ERRORES' USING ERR-AREA
           STOP RUN.
       9000-FIN.
           DISPLAY 'CUENTAS TOTALIZADAS: ' WS-TOTAL-CUENTAS
           DISPLAY 'SALDO TOTAL:         ' WS-SALDO-TOTAL
           CLOSE CUENTAS
           CLOSE CONTROLES.
